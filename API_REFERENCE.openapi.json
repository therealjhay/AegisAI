{
  "openapi": "3.1.0",
  "info": {
    "title": "AegisAI Brain Service",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/triage": {
      "post": {
        "summary": "Triage",
        "operationId": "triage_triage_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TriageRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TriageResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "TriageRequest": {
        "properties": {
          "raw_text": {
            "type": "string",
            "minLength": 1,
            "title": "Raw Text",
            "description": "Unstructured disaster report text"
          }
        },
        "type": "object",
        "required": [
          "raw_text"
        ],
        "title": "TriageRequest"
      },
      "TriageResponse": {
        "properties": {
          "disaster_type": {
            "type": "string",
            "title": "Disaster Type"
          },
          "urgency_score": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Urgency Score"
          },
          "location_mentions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Location Mentions"
          },
          "classification_source": {
            "type": "string",
            "title": "Classification Source"
          }
        },
        "type": "object",
        "required": [
          "disaster_type",
          "urgency_score",
          "location_mentions",
          "classification_source"
        ],
        "title": "TriageResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}