{
  "name": "aegis",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:lint": "npm --prefix frontend run lint",
    "ingest:mock": "tsx src/ingestion/index.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:init": "docker compose exec -T db psql -U aegis -d aegis -f prisma/init.sql",
    "test:unit": "tsx --test src/**/*.test.ts",
    "test": "npm run prisma:validate && npm run prisma:generate && npm run build && npm run test:unit"
  },
  "keywords": [
    "aegis",
    "postgis",
    "prisma"
  ],
  "license": "MIT",
  "description": "AEGIS database and geospatial schema bootstrap",
  "devDependencies": {
    "@types/node": "^22.10.1",
    "prisma": "^5.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@prisma/client": "^5.15.0",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "zod": "^3.24.1"
  }
}
